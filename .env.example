NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
VITE_DEFAULT_DATA_MODE=live

# Prefer DATABASE_URL. If unset, DB_* vars below are used.
DATABASE_URL=mysql://<db_user>:<db_password>@127.0.0.1:3306/hotspot_forecast
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotspot_forecast
DB_USER=<db_user>
DB_PASSWORD=<db_password>

# App/Auth
JWT_SECRET=<random_hex_secret>
CONNECTOR_SECRET_KEY=<connector_secret>
APP_PUBLIC_BASE_URL=http://localhost:3000

# Platform/API keys
# TIKHUB_API_KEY:服务端运行时 + 项目根 .mcp.json 共用(.mcp.json 以 ${TIKHUB_API_KEY} 引用)
TIKHUB_API_KEY=
THIRD_PARTY_LLM_BASE_URL=
THIRD_PARTY_LLM_API_KEY=
# Optional: Apollo 图片生成专用分组 key。缺失时复用 THIRD_PARTY_LLM_API_KEY。
APOLLO_IMAGE_BASE_URL=
APOLLO_IMAGE_API_KEY=
# Optional: Apollo 视频理解专用分组 key。apollo 模型优先用它，缺失时回退 THIRD_PARTY_LLM_API_KEY。
THIRD_PARTY_LLM_VIDEO_API_KEY=
ARK_API_KEY=
ARK_DOUBAO_ENDPOINT_ID=
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=

# Optional integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=

# 灯灰度：是否对深度拆解等分析动作真实扣积分。
# 默认 false（不扣，保留当前免费体验）；UI 始终显示余额、本次消耗等。
# 上线计费时改为 true 即可（建议先发公告 / 灰度名单）
CREDIT_DEDUCTION_ENABLED=false
VITE_APP_ID=hotspot-forecast
APP_ID=hotspot-forecast
OWNER_OPEN_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
